//@version=6

// ──────────────────────────────────────────────────────────────────────────
// Description: TEMPLATE — replace with strategy thesis and assumptions.
// Repainting status: Non-repainting. Orders processed on bar close.
// Realism: 0.05% commission, 2-tick slippage. Adjust to broker.
// ──────────────────────────────────────────────────────────────────────────

strategy(title                  = "Strategy Name",
         overlay                = true,
         initial_capital        = 10000,
         default_qty_type       = strategy.percent_of_equity,
         default_qty_value      = 10,
         commission_type        = strategy.commission.percent,
         commission_value       = 0.05,
         slippage               = 2,
         pyramiding             = 0,
         calc_on_every_tick     = false,
         process_orders_on_close = true,
         margin_long            = 100,
         margin_short           = 100)

// ──────────────────────────────────────────────────────────────────────────
// CONSTANTS
// ──────────────────────────────────────────────────────────────────────────
const color BULL_COLOR = #26a69a
const color BEAR_COLOR = #ef5350

// ──────────────────────────────────────────────────────────────────────────
// INPUTS
// ──────────────────────────────────────────────────────────────────────────
// Entry logic
fastLenInput = input.int(10, "Fast length", minval = 1, group = "Entry")
slowLenInput = input.int(30, "Slow length", minval = 2, group = "Entry")

// Risk management
riskPctInput      = input.float(1.0, "Risk per trade %", minval = 0.1, maxval = 5.0, step = 0.1,
    group = "Risk", tooltip = "Percentage of equity to risk on each trade.")
atrLengthInput    = input.int(14, "ATR length", minval = 1, group = "Risk")
atrStopMultInput  = input.float(2.0, "ATR stop multiplier", minval = 0.5, step = 0.1, group = "Risk")
atrTpMultInput    = input.float(4.0, "ATR take-profit multiplier", minval = 0.5, step = 0.1, group = "Risk")

// Filters
useTimeFilterInput = input.bool(false, "Restrict to session", group = "Filters")
sessionInput       = input.session("0930-1600", "Trading session", group = "Filters")

// ──────────────────────────────────────────────────────────────────────────
// CALCULATIONS
// ──────────────────────────────────────────────────────────────────────────
float fast = ta.sma(close, fastLenInput)
float slow = ta.sma(close, slowLenInput)
float atr  = ta.atr(atrLengthInput)

bool inSession = not useTimeFilterInput or not na(time(timeframe.period, sessionInput))

bool longSig  = ta.crossover(fast, slow)  and barstate.isconfirmed and inSession
bool shortSig = ta.crossunder(fast, slow) and barstate.isconfirmed and inSession

// Risk-based position sizing: qty * stop_distance = equity * risk%
float stopDist  = atr * atrStopMultInput
float positionQty = (strategy.equity * riskPctInput / 100) / math.max(stopDist, syminfo.mintick)

// ──────────────────────────────────────────────────────────────────────────
// ORDERS
// ──────────────────────────────────────────────────────────────────────────
if longSig
    strategy.entry("Long", strategy.long, qty = positionQty)
    strategy.exit("LX", "Long",
        stop  = close - stopDist,
        limit = close + atr * atrTpMultInput,
        comment_loss = "SL", comment_profit = "TP")

if shortSig
    strategy.entry("Short", strategy.short, qty = positionQty)
    strategy.exit("SX", "Short",
        stop  = close + stopDist,
        limit = close - atr * atrTpMultInput,
        comment_loss = "SL", comment_profit = "TP")

// ──────────────────────────────────────────────────────────────────────────
// VISUALS
// ──────────────────────────────────────────────────────────────────────────
plot(fast, "Fast MA", color.new(BULL_COLOR, 0), linewidth = 1)
plot(slow, "Slow MA", color.new(BEAR_COLOR, 0), linewidth = 2)

plotshape(longSig,  "Long entry",  shape.triangleup,   location.belowbar, BULL_COLOR, size = size.small)
plotshape(shortSig, "Short entry", shape.triangledown, location.abovebar, BEAR_COLOR, size = size.small)
